<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Library</OutputType>
    <DrivePluginManaged>true</DrivePluginManaged>
    <PublishAot>false</PublishAot><PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile><SelfContained>false</SelfContained>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Drive.Plugin.SDK/Drive.Plugin.SDK.csproj" />
    <ProjectReference Include="../../Drive.Plugin.Avalonia/Drive.Plugin.Avalonia.csproj" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <!-- 共用已验证的图片读写源码；运行时不依赖图片处理插件。 -->
    <Compile Include="../ImageToolsPlugin/Core/ImageProcessor.cs" Link="Core/ImageProcessor.cs" />
    <AvaloniaResource Include="Assets/**" />
    <None Update="Models/**;Licenses/**;README.md;THIRD-PARTY-NOTICES.txt;Assets/Fonts/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="PortraitRetouchChecks" />
  </ItemGroup>
  <Import Project="../../Drive.Plugin.SDK/buildTransitive/Drive.Plugin.SDK.targets" />
</Project>
