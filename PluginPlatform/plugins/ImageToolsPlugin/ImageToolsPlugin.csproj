<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Library</OutputType>
    <DrivePluginManaged>true</DrivePluginManaged>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Drive.Plugin.SDK/Drive.Plugin.SDK.csproj" />
    <ProjectReference Include="../../Drive.Plugin.Avalonia/Drive.Plugin.Avalonia.csproj" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="RapidOcrNet" Version="4.2.0" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <AvaloniaResource Include="Assets/**" />
    <InternalsVisibleTo Include="ImageToolsChecks" />
  </ItemGroup>
  <Import Project="../../Drive.Plugin.SDK/buildTransitive/Drive.Plugin.SDK.targets" />
</Project>
