<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:drive_desktop.Components.TemplateControls">
    <Design.PreviewWith>
        <controls:CodeView />
    </Design.PreviewWith>

    <Style Selector="controls|CodeView">
        <Setter Property="Template">
            <ControlTemplate>
                <TextBlock Text="Templated Control" />
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
