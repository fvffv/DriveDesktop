<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:drive_desktop.ViewModels"
             xmlns:tc="using:drive_desktop.Components.TemplateControls"
             xmlns:u="https://irihi.tech/ursa"
             x:DataType="vm:ImageViewModel"
             x:Class="drive_desktop.Components.UserControls.ImageViewDialog">
    <UserControl.DataContext>
        <vm:ImageViewModel />
    </UserControl.DataContext>
    <UserControl.Styles>
        <Style Selector="Border#PART_DialogCard">
            <Setter Property="RenderTransform" Value="translateY(-50px)" />

        </Style>
        <Style Selector="Panel.bg">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.defalut">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Panel.open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <Style Selector="Panel.open Border#PART_DialogCard">
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>
        <!--四个按钮的图标样式-->
        <Style Selector="PathIcon.icon">
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />

        </Style>
    </UserControl.Styles>
    <!--{Binding IsShowImageViewDialog}-->
    <Panel Classes="bg" Classes.defalut="{Binding !IsShowImageViewDialog}" Classes.open="{Binding IsShowImageViewDialog}">
        <!--背景遮罩-->
        <Border Background="#66000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        <!--加载-->
        <u:LoadingContainer
            IsLoading="{Binding !IsLoaded}"
            LoadingMessage="加载中..."/>
        <!--图片展示-->
        <u:ImageViewer Tapped="InputElement_OnTapped" Stretch="None" MinScale="0.1" Scale="{Binding ImgScale}"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                       x:Name="Viewer"
                       Source="{Binding Source,Mode=OneWay}" >
            <u:ImageViewer.RenderTransform>
                <RotateTransform Angle="{Binding RotationAngle}">
                    <RotateTransform.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Angle" 
                                              Duration="0:0:0.4" 
                                              Easing="CubicEaseOut" />
                        </Transitions>
                    </RotateTransform.Transitions>
                </RotateTransform>
            </u:ImageViewer.RenderTransform>
           
        </u:ImageViewer>
        <!--下面四个功能按钮-->
        <Border Margin="0,0,0,20" Padding="10" Background="{DynamicResource RadioButtonCheckBg}" CornerRadius="50"
                HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" Orientation="Horizontal">
                <Button Classes="naked" Command="{Binding ScaleButtonCommand}" CommandParameter="0">
                    <PathIcon Classes="icon"
                              Data="m795.904 750.72 124.992 124.928a32 32 0 0 1-45.248 45.248L750.656 795.904a416 416 0 1 1 45.248-45.248zM480 832a352 352 0 1 0 0-704 352 352 0 0 0 0 704M352 448h256a32 32 0 0 1 0 64H352a32 32 0 0 1 0-64" />
                </Button>
                <Button Classes="naked" Command="{Binding ScaleButtonCommand}" CommandParameter="1">
                    <PathIcon Classes="icon"
                              Data="m795.904 750.72 124.992 124.928a32 32 0 0 1-45.248 45.248L750.656 795.904a416 416 0 1 1 45.248-45.248zM480 832a352 352 0 1 0 0-704 352 352 0 0 0 0 704m-32-384v-96a32 32 0 0 1 64 0v96h96a32 32 0 0 1 0 64h-96v96a32 32 0 0 1-64 0v-96h-96a32 32 0 0 1 0-64z" />
                </Button>
                <Button Classes="naked" Command="{Binding RotateButtonCommand}" CommandParameter="0">
                    <PathIcon Classes="icon"
                              Data="M289.088 296.704h92.992a32 32 0 0 1 0 64H232.96a32 32 0 0 1-32-32V179.712a32 32 0 0 1 64 0v50.56a384 384 0 0 1 643.84 282.88 384 384 0 0 1-383.936 384 384 384 0 0 1-384-384h64a320 320 0 1 0 640 0 320 320 0 0 0-555.712-216.448z" />
                </Button>
                <Button Classes="naked" Command="{Binding RotateButtonCommand}" CommandParameter="1">
                    <PathIcon Classes="icon"
                              Data="M784.512 230.272v-50.56a32 32 0 1 1 64 0v149.056a32 32 0 0 1-32 32H667.52a32 32 0 1 1 0-64h92.992A320 320 0 1 0 524.8 833.152a320 320 0 0 0 320-320h64a384 384 0 0 1-384 384 384 384 0 0 1-384-384 384 384 0 0 1 643.712-282.88" />
                </Button>
            </StackPanel>
        </Border>
    </Panel>


</UserControl>