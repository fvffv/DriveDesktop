<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:vm="using:drive_desktop.ViewModels"
        x:DataType="vm:VideoPreviewViewModel"
        Width="600"
        Height="450"
        WindowStartupLocation="CenterScreen"
        xmlns:media="using:NativeMedia.Avalonia"
        x:Class="drive_desktop.Views.VideoPreviewView"
        Title="{Binding Title}">
        <Design.DataContext>
                <vm:VideoPreviewViewModel  />
        </Design.DataContext>
        <media:VideoPlayer PlaybackQuality="Original"
                           ShowControls="True"
                           Source="{Binding VideoSource}"
                           AutoPlay="True"/>
</Window>
